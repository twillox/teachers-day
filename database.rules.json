{
  "rules": {
    "live_sessions": {
      "$gameCode": {
        ".read": "true",
        ".write": "auth != null && data.child('createdBy').val() === auth.uid || newData.child('createdBy').val() === auth.uid",
        "participants": {
          "$participantId": {
            ".write": "auth != null && data.parent().parent().child('createdBy').val() === auth.uid || (!data.exists() && newData.child('id').val() === $participantId)",
          }
        },
        "responses": {
          ".write": "false"
        }
      }
    }
  }
}